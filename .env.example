# ============================================================
# PM Copilot 环境变量模板
# 复制为 .env 后填写（.env 已被 gitignore，切勿提交）
# ============================================================

# ---- 应用 ----
ENVIRONMENT=development

# ---- DeepSeek AI ----
# API Key 仅在后端环境变量中配置，严禁写入前端代码
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 数据库（SQLite）----
DATABASE_URL=sqlite:///./pm_copilot.db

# ---- 密钥加密（TODO：API Key 加密主密钥，当前占位未启用）----
SECRET_ENCRYPTION_KEY=

# ---- 服务器默认模型（访客无自有配置时自动回退；用于简历演示等场景，留空=不启用）----
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_MODEL=deepseek-flash
DEFAULT_LLM_API_KEY=
DEFAULT_EMBEDDING_PROVIDER=custom
DEFAULT_EMBEDDING_BASE_URL=
DEFAULT_EMBEDDING_MODEL=text-embedding-v4
DEFAULT_EMBEDDING_API_KEY=

# ---- CORS（可选；默认已内置 localhost:5173）----
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
